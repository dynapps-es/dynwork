            "resource_id": "07c66646-8524-435c-b8d5-006a61ce6d5b",
            "revision_id": "c1e0c608-3445-4610-816a-97cbcdfead56"
          },
          "sha256": "c3cba251fb3c18f678694e76f288365e28e7ab1e30eb55bf82833adeedea4fb0",
          "tags": ["commons", "profile", "onboarding"]
        }
