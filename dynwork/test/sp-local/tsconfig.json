{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@tsconfig/bun/tsconfig.json",
  "compilerOptions": {
    "types": ["bun"],
    "noUnusedLocals": true,
    "noEmit": true,
    // sp-local.ts loads Playwright from packages/app at runtime (dynwork/ has no dependency on it); types only
    "paths": { "@playwright/test": ["../../../packages/app/node_modules/@playwright/test"] }
  },
  "include": ["*.ts", "../../script/sp-local.ts"]
}
